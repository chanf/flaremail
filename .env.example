# 本地开发测试环境变量参考
DOMAIN=example.com
MAIL_TTL_SECONDS=1800

# ──── AI 自学习验证码提取（可选）────
# 仅在第 1 层（正则）和第 2 层（KV 规则）都失败时调用，有 token 成本和网络延迟
# 必须通过环境变量注入，严禁写入代码或提交到 Git
AI_PROVIDER=openai                 # openai / zhipu / deepseek / cloudflare
AI_API_KEY=sk-your-api-key         # 替换为你的真实密钥，不要提交
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
AI_MAX_DAILY_CALLS=100             # 每日最大 AI 调用次数，超限后仅保留第 1、2 层
AI_CONFIDENCE_THRESHOLD=0.6        # 接受 AI 结果的最低置信度
